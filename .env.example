# KodBank environment template — copy to .env (gitignored) and fill real values.

# Database
DB_URL=jdbc:mysql://localhost:3306/atm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# Server
SERVER_PORT=8080
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# JWT — use a long random string (min 32 bytes)
JWT_SECRET=replace-with-at-least-32-random-bytes-here
JWT_EXPIRATION_MS=28800000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS — comma-separated origin patterns for your frontend host
# Same-origin (Spring serves the SPA) can stay localhost-only in dev:
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://your-domain.example

# Admin seed (only used when the admin row does not exist yet)
ADMIN_USERNAME=admin
ADMIN_PIN=change-me
ADMIN_CARD=9999999999999999
ADMIN_SECURITY_ANSWER=change-me

# OTP — set OTP_INCLUDE_CODE=false once you deliver OTP via SMS/email
OTP_INCLUDE_CODE=true
OTP_TTL_SECONDS=300
OTP_WITHDRAW_THRESHOLD=5000

# Business limits
MAX_LOGIN_ATTEMPTS=3
MAX_WITHDRAWAL=10000
OPENING_BALANCE=0
DAILY_LIMIT=50000
